from PyQt6.QtWidgets import QApplication, QWidget, QGridLayout, QPushButton, QLabel
import sys

class Window(QWidget):
    def __init__(self):
        super().__init__()

        self.setWindowTitle("Kółko i Krzyżyk")
        self.layout = QGridLayout(self)

        self.board = []
        self.current_player = ["X"]
        self.status_label = QLabel("Tura gracza: X")
        self.layout.addWidget(self.status_label, 0, 0, 1, 3)


        self.score_label = QLabel("Punkty - X: 0  O: 0")
        self.layout.addWidget(self.score_label, 1, 0, 1, 3)

       
        self.player_x_points = 0
        self.player_o_points = 0

        self.create_buttons()
        self.create_reset_button()

    def create_buttons(self):
        self.btn_00 = QPushButton(" ", self)
        self.btn_00.setFixedSize(100, 100)
        self.btn_00.clicked.connect(self.on_button_click_00)

        self.btn_01 = QPushButton(" ", self)
        self.btn_01.setFixedSize(100, 100)
        self.btn_01.clicked.connect(self.on_button_click_01)

        self.btn_02 = QPushButton(" ", self)
        self.btn_02.setFixedSize(100, 100)
        self.btn_02.clicked.connect(self.on_button_click_02)

        self.btn_10 = QPushButton(" ", self)
        self.btn_10.setFixedSize(100, 100)
        self.btn_10.clicked.connect(self.on_button_click_10)

        self.btn_11 = QPushButton(" ", self)
        self.btn_11.setFixedSize(100, 100)
        self.btn_11.clicked.connect(self.on_button_click_11)

        self.btn_12 = QPushButton(" ", self)
        self.btn_12.setFixedSize(100, 100)
        self.btn_12.clicked.connect(self.on_button_click_12)

        self.btn_20 = QPushButton(" ", self)
        self.btn_20.setFixedSize(100, 100)
        self.btn_20.clicked.connect(self.on_button_click_20)

        self.btn_21 = QPushButton(" ", self)
        self.btn_21.setFixedSize(100, 100)
        self.btn_21.clicked.connect(self.on_button_click_21)

        self.btn_22 = QPushButton(" ", self)
        self.btn_22.setFixedSize(100, 100)
        self.btn_22.clicked.connect(self.on_button_click_22)

        self.board = [
            [self.btn_00, self.btn_01, self.btn_02],
            [self.btn_10, self.btn_11, self.btn_12],
            [self.btn_20, self.btn_21, self.btn_22]
        ]


        for row in range(3):
            for col in range(3):
                self.layout.addWidget(self.board[row][col], row + 2, col)

    def on_button_click_00(self):
        self.button_click(self.btn_00)

    def on_button_click_01(self):
        self.button_click(self.btn_01)

    def on_button_click_02(self):
        self.button_click(self.btn_02)

    def on_button_click_10(self):
        self.button_click(self.btn_10)

    def on_button_click_11(self):
        self.button_click(self.btn_11)

    def on_button_click_12(self):
        self.button_click(self.btn_12)

    def on_button_click_20(self):
        self.button_click(self.btn_20)

    def on_button_click_21(self):
        self.button_click(self.btn_21)

    def on_button_click_22(self):
        self.button_click(self.btn_22)

    def create_reset_button(self):
        self.reset_button = QPushButton("Reset", self)
        self.reset_button.setFixedSize(100, 50)
        self.reset_button.clicked.connect(self.reset_game)
        self.layout.addWidget(self.reset_button, 5, 0, 1, 3)

    def button_click(self, button):
        if button.text() == " ":
            button.setText(self.current_player[0])
            winner = self.check_winner()
            if winner:
                self.status_label.setText(f"Wygrał: {winner}")
                if winner == "X":
                    self.player_x_points += 1
                elif winner == "O":
                    self.player_o_points += 1
                self.update_score()

                for row in self.board:
                    for btn in row:
                        btn.setEnabled(False)
            else:
                self.current_player[0] = "O" if self.current_player[0] == "X" else "X"
                self.status_label.setText(f"Tura gracza: {self.current_player[0]}")

    def update_score(self):

        self.score_label.setText(f"Punkty - X: {self.player_x_points}  O: {self.player_o_points}")

    def reset_game(self):

        for row in self.board:
            for btn in row:
                btn.setText(" ")
                btn.setEnabled(True)
        self.current_player[0] = "X"
        self.status_label.setText(f"Tura gracza: {self.current_player[0]}")

    def check_winner(self):
        if self.btn_00.text() == self.btn_01.text() == self.btn_02.text() != " ":
            return self.btn_00.text()
        if self.btn_10.text() == self.btn_11.text() == self.btn_12.text() != " ":
            return self.btn_10.text()
        if self.btn_20.text() == self.btn_21.text() == self.btn_22.text() != " ":
            return self.btn_20.text()

        if self.btn_00.text() == self.btn_10.text() == self.btn_20.text() != " ":
            return self.btn_00.text()
        if self.btn_01.text() == self.btn_11.text() == self.btn_21.text() != " ":
            return self.btn_01.text()
        if self.btn_02.text() == self.btn_12.text() == self.btn_22.text() != " ":
            return self.btn_02.text()

        if self.btn_00.text() == self.btn_11.text() == self.btn_22.text() != " ":
            return self.btn_00.text()
        if self.btn_02.text() == self.btn_11.text() == self.btn_20.text() != " ":
            return self.btn_02.text()

        if all(self.board[i][j].text() != " " for i in range(3) for j in range(3)):
            return "Remis"

        return None

app = QApplication(sys.argv)
window = Window()
window.show()
app.exec()
